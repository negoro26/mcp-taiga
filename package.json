{
  "name": "mcp-taiga",
  "version": "1.0.0",
  "description": "Taiga MCP server in TypeScript: six op-dispatching tools over MCP revision 2025-11-25",
  "type": "module",
  "bin": {
    "mcp-taiga": "dist/src/index.js"
  },
  "main": "dist/src/index.js",
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "lint": "oxlint src test",
    "start": "node dist/src/index.js",
    "test": "npm run build && node dist/test/unitTest.js && node dist/test/protocolTest.js && node dist/test/apiContractTest.js",
    "test:unit": "npm run build && node dist/test/unitTest.js",
    "test:protocol": "npm run build && node dist/test/protocolTest.js",
    "test:contract": "npm run build && node dist/test/apiContractTest.js",
    "test:integration": "npm run build && node dist/test/integration.js",
    "prepublishOnly": "npm run check && npm run lint && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.19.0",
    "dotenv": "^17.0.0",
    "zod": "^4.4.3"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "taiga",
    "project-management",
    "agile",
    "scrum"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/negoro26/mcp-taiga.git"
  },
  "homepage": "https://github.com/negoro26/mcp-taiga#readme",
  "author": "negoro26",
  "devDependencies": {
    "@oxlint/plugins": "^1.78.0",
    "@types/node": "^26.2.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2"
  },
  "bugs": {
    "url": "https://github.com/negoro26/mcp-taiga/issues"
  },
  "private": false
}

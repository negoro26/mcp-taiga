{
  "name": "mcp-taiga",
  "version": "1.0.0",
  "description": "Taiga MCP server in TypeScript: six op-dispatching tools over MCP revision 2026-07-28",
  "type": "module",
  "bin": {
    "mcp-taiga": "dist/src/index.js"
  },
  "main": "dist/src/index.js",
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "lint": "oxlint src test",
    "start": "node dist/src/index.js",
    "test": "npm run build && node dist/test/unitTest.js && node dist/test/protocolTest.js && node dist/test/apiContractTest.js && node dist/test/httpTest.js",
    "test:unit": "npm run build && node dist/test/unitTest.js",
    "test:protocol": "npm run build && node dist/test/protocolTest.js",
    "test:contract": "npm run build && node dist/test/apiContractTest.js",
    "test:integration": "npm run build && node dist/test/integration.js",
    "test:http": "npm run build && node dist/test/httpTest.js",
    "prepublishOnly": "npm run check && npm run lint && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "zod": "^4.6.5"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "taiga",
    "project-management",
    "agile",
    "scrum",
    "kanban",
    "issue-tracking",
    "sprint",
    "wiki",
    "llm-tools",
    "ai-agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/negoro26/mcp-taiga.git"
  },
  "homepage": "https://github.com/negoro26/mcp-taiga#readme",
  "author": "negoro26",
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@oxlint/plugins": "^1.85.0",
    "@types/node": "^26.6.2",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2"
  },
  "bugs": {
    "url": "https://github.com/negoro26/mcp-taiga/issues"
  },
  "private": false
}
